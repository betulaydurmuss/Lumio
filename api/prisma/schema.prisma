// Every tenant-owned row carries org_id, and every query on such a row is
// scoped by it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  learner
  instructor
  org_admin
  platform_admin
}

enum Locale {
  tr
  en
}

enum OrganizationKind {
  personal
  company
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  slug      String           @unique
  name      String
  kind      OrganizationKind @default(company)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users          User[]
  sessions       Session[]
  auditLogs      AuditLog[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  invitations    Invitation[]
  assignments    Assignment[]
  notifications  Notification[]
  consents       ConsentRecord[]
  wishlist       WishlistItem[]

  @@map("organizations")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  email             String
  displayName       String    @map("display_name")
  passwordHash      String?   @map("password_hash")
  role              Role      @default(learner)
  locale            Locale    @default(tr)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  /// AES-256-GCM ciphertext, never the raw base32 secret.
  totpSecret        String?   @map("totp_secret")
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// SHA-256 hashes of the unused recovery codes; each one opens the account once.
  totpRecoveryCodes String[]  @default([]) @map("totp_recovery_codes")
  failedLogins      Int       @default(0) @map("failed_logins")
  lockedUntil       DateTime? @map("locked_until")
  /// A deactivated member cannot sign in, and their sessions are ended.
  disabledAt        DateTime? @map("disabled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sessions           Session[]
  auditLogs          AuditLog[]
  verificationTokens EmailVerification[]
  passwordResets     PasswordReset[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]
  invitationsSent    Invitation[]
  assignments        Assignment[]        @relation("AssignedTo")
  assignmentsMade    Assignment[]        @relation("AssignedBy")
  notifications      Notification[]
  consents           ConsentRecord[]
  wishlist           WishlistItem[]
  instructorProfile  Instructor?

  /// Stored lower-cased. One address is one account, so sign-in needs no organization picker.
  @@unique([email])
  @@index([orgId])
  @@map("users")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

/// A one-time link that sets a new password. Only its hash is stored.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// The hash this session rotated away from. Seeing it again means the token was stolen.
  previousHash     String?   @unique @map("previous_hash")
  mfaVerified      Boolean   @default(false) @map("mfa_verified")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@map("sessions")
}

/// Append-only. Rows are never updated or deleted by the application.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ---- Catalog ----------------------------------------------------------------
// The public catalog belongs to the platform, not to a tenant: every visitor sees
// the same published courses. What a user does with a course (enrolling, saving
// it) belongs to their organization and is tenant-scoped.

enum CourseLevel {
  beginner
  intermediate
  advanced
  all
}

enum CourseStatus {
  draft
  published
}

enum LessonType {
  video
  interactive
  reading
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  parentId String? @map("parent_id") @db.Uuid
  nameTr   String  @map("name_tr")
  nameEn   String  @map("name_en")
  position Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@index([parentId])
  @@map("categories")
}

model Instructor {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String? @unique @map("user_id") @db.Uuid
  slug       String  @unique
  name       String
  headlineTr String  @map("headline_tr")
  headlineEn String  @map("headline_en")
  bioTr      String  @map("bio_tr")
  bioEn      String  @map("bio_en")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses Course[]

  @@map("instructors")
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  categoryId      String       @map("category_id") @db.Uuid
  instructorId    String       @map("instructor_id") @db.Uuid
  status          CourseStatus @default(draft)
  titleTr         String       @map("title_tr")
  titleEn         String       @map("title_en")
  subtitleTr      String       @map("subtitle_tr")
  subtitleEn      String       @map("subtitle_en")
  descriptionTr   String       @map("description_tr")
  descriptionEn   String       @map("description_en")
  outcomesTr      String[]     @map("outcomes_tr")
  outcomesEn      String[]     @map("outcomes_en")
  requirementsTr  String[]     @map("requirements_tr")
  requirementsEn  String[]     @map("requirements_en")
  audienceTr      String[]     @map("audience_tr")
  audienceEn      String[]     @map("audience_en")
  level           CourseLevel
  /// The language the course is taught in, independent of the interface language.
  language        Locale
  /// Minor units (kuruş). Zero means free.
  priceAmount     Int          @default(0) @map("price_amount")
  /// The list price before a discount, if one is shown.
  listPriceAmount Int?         @map("list_price_amount")
  currency        String       @default("TRY")
  hasCertificate  Boolean      @default(true) @map("has_certificate")
  coverStyle      String       @default("a") @map("cover_style")
  /// Titles, subtitles and instructor in both languages, folded by normalizeSearch().
  searchText      String       @default("") @map("search_text")
  /// Denormalised for sorting and the course card; recomputed when content changes.
  durationMinutes Int          @default(0) @map("duration_minutes")
  lessonCount     Int          @default(0) @map("lesson_count")
  ratingAverage   Decimal      @default(0) @map("rating_average") @db.Decimal(2, 1)
  ratingCount     Int          @default(0) @map("rating_count")
  enrollmentCount Int          @default(0) @map("enrollment_count")
  completionCount Int          @default(0) @map("completion_count")
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  sections     Section[]
  enrollments  Enrollment[]
  assignments  Assignment[]
  wishlistedBy WishlistItem[]
  quizzes      Quiz[]

  @@index([status, categoryId])
  @@index([status, enrollmentCount])
  @@index([status, publishedAt])
  @@map("courses")
}

model Section {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  position Int
  titleTr  String @map("title_tr")
  titleEn  String @map("title_en")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quiz    Quiz?

  @@unique([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  sectionId       String     @map("section_id") @db.Uuid
  position        Int
  type            LessonType
  titleTr         String     @map("title_tr")
  titleEn         String     @map("title_en")
  durationMinutes Int        @map("duration_minutes")
  /// Free preview lessons can be opened from the course page without enrolling.
  isPreview       Boolean    @default(false) @map("is_preview")
  /// Reading and interactive content, validated against lessonBodySchema. Null until written.
  bodyTr          Json?      @map("body_tr")
  bodyEn          Json?      @map("body_en")
  /// Keys in the media store, never public paths. Served only through signed, expiring links.
  videoKey        String?    @map("video_key")
  captionsTrKey   String?    @map("captions_tr_key")
  captionsEnKey   String?    @map("captions_en_key")
  videoSeconds    Int?       @map("video_seconds")

  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attachments LessonAttachment[]

  @@unique([sectionId, position])
  @@map("lessons")
}

/// A file that goes with a lesson: a checklist, slides, sample code. Like the
/// video, it lives in the media store and is handed out by signed link only.
model LessonAttachment {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  position Int
  key      String
  titleTr  String @map("title_tr")
  titleEn  String @map("title_en")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@map("lesson_attachments")
}

model Enrollment {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Set once every lesson is done and every quiz passed. Certificates are issued from this.
  completedAt DateTime? @map("completed_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([orgId])
  @@map("enrollments")
}

/// A course an organization asks one of its members to take, optionally by a date.
/// Progress itself lives on the enrollment the assignment creates.
model Assignment {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  /// The last day to finish, as a calendar date.
  dueOn        DateTime? @map("due_on") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([orgId, dueOn])
  @@map("assignments")
}

enum NotificationKind {
  course_assigned
  certificate_issued
  password_changed
  two_factor_enabled
}

/// Something a member should know about. Only structured data is stored; the
/// words are put together in the member's language when it is shown.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orgId])
  @@map("notifications")
}

enum ConsentKind {
  marketing_email
}

/// Every time a member gives or withdraws a consent, with the notice version
/// they saw. The current state is the newest row; the rest is the proof.
model ConsentRecord {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  kind          ConsentKind
  granted       Boolean
  noticeVersion String      @map("notice_version")
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([orgId])
  @@map("consent_records")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([orgId])
  @@map("wishlist_items")
}

/// Counts searches so the catalog can suggest what others look for. Holds no user data.
model SearchTerm {
  term      String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([count])
  @@map("search_terms")
}

/// One row per learner and lesson. Written only for lessons of courses the learner is enrolled in.
model LessonProgress {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  positionSeconds Int       @default(0) @map("position_seconds")
  completedAt     DateTime? @map("completed_at")
  /// When the server first heard about this lesson: the clock completion is measured against.
  startedAt       DateTime  @default(now()) @map("started_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@index([orgId])
  @@map("lesson_progress")
}

// ---- Assessment ---------------------------------------------------------------

/// A section quiz belongs to one section; the final exam has no section and opens
/// once every lesson is done. Correct answers never leave the server before grading.
model Quiz {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @map("course_id") @db.Uuid
  sectionId   String? @unique @map("section_id") @db.Uuid
  titleTr     String  @map("title_tr")
  titleEn     String  @map("title_en")
  passPercent Int     @default(70) @map("pass_percent")

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section?       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  quizId        String   @map("quiz_id") @db.Uuid
  position      Int
  promptTr      String   @map("prompt_tr")
  promptEn      String   @map("prompt_en")
  optionsTr     String[] @map("options_tr")
  optionsEn     String[] @map("options_en")
  correctIndex  Int      @map("correct_index")
  explanationTr String   @map("explanation_tr")
  explanationEn String   @map("explanation_en")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, position])
  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  quizId    String   @map("quiz_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  /// The chosen option index for each question, in question order.
  answers   Int[]
  score     Int
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([orgId])
  @@map("quiz_attempts")
}

// ---- Certificates -------------------------------------------------------------

/// Ed25519 keys that sign certificates. The private key is stored encrypted with
/// ENCRYPTION_KEY; the public key is published so anyone can check a signature.
model SigningKey {
  id         String    @id
  algorithm  String    @default("Ed25519")
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// A retired key no longer signs, but still verifies what it signed.
  retiredAt  DateTime? @map("retired_at")

  @@map("signing_keys")
}

/// Everything printed on the certificate is copied here when it is issued and
/// covered by the signature, so a later rename cannot change an issued document.
model Certificate {
  id             String    @id @default(uuid()) @db.Uuid
  certNo         String    @unique @map("cert_no")
  orgId          String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  courseId       String    @map("course_id") @db.Uuid
  enrollmentId   String    @unique @map("enrollment_id") @db.Uuid
  /// Shown in the QR link. Without it the public page masks the holder's name.
  verifyCode     String    @map("verify_code")
  recipientName  String    @map("recipient_name")
  /// Null for personal accounts, which have no organization to print.
  orgName        String?   @map("org_name")
  courseTitleTr  String    @map("course_title_tr")
  courseTitleEn  String    @map("course_title_en")
  instructorName String    @map("instructor_name")
  hours          Int
  startedAt      DateTime  @map("started_at")
  completedAt    DateTime  @map("completed_at")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  signature      String
  keyId          String    @map("key_id")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([userId])
  @@map("certificates")
}

/// A single-use link that lets someone join an organization with a given role.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invitations")
}
