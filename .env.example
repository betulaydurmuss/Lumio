# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development

# API
API_PORT=4001
WEB_ORIGIN=http://localhost:5174
# 32+ random bytes, e.g. `openssl rand -base64 48`
COOKIE_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_SECRET=change-me-to-another-long-random-string-of-32-chars
# 32 random bytes as base64, e.g. `openssl rand -base64 32`. Encrypts TOTP seeds at rest.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Host ports, offset so Lumio can run next to other local stacks
POSTGRES_PORT=5433
REDIS_PORT=6380
MAILPIT_UI_PORT=8026
WEB_PORT=8080

# PostgreSQL
POSTGRES_USER=lumio
POSTGRES_PASSWORD=lumio
POSTGRES_DB=lumio
DATABASE_URL=postgresql://lumio:lumio@localhost:5433/lumio?schema=public

# Redis. Any long random string, e.g. `openssl rand -hex 24`.
REDIS_PASSWORD=change-me-to-a-random-redis-password
REDIS_URL=redis://:change-me-to-a-random-redis-password@localhost:6380

# Mail (Mailpit in development, UI on http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Lumio <no-reply@lumio.local>"
